{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "types": [
      "node"
    ],
    "rootDir": "server",
    "outDir": "server/.build",
    "strict": true,
    "noEmitOnError": true,
    "verbatimModuleSyntax": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": [
    "server/**/*.ts"
  ]
}
